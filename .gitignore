# Third-party source data: fetched by scripts/fetch_sources.py, never committed.
# The wiki dumps are hundreds of MB compressed and git history never shrinks, and
# each source carries its own licence -- Memory Alpha is CC BY-NC, which must not
# be redistributed from a public repo at all. data/MANIFEST.csv IS tracked and
# carries the sha256 of every file, which is what makes drift detectable without
# storing the bytes. Rebuild with `make data`.
data/raw/

# Generated corpus: rebuilt by `make data` from data/raw/ + data/curated/.
# Derived from the upstream wiki text, so it inherits the upstream licence and
# stays out of the repo for the same reason data/raw/ does.
data/derived/

# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# OS / editor
.DS_Store
.vscode/
.idea/
*.swp

# Secrets: .gitignore baseline (docs/policy/repo-standards.md)
.env
.env.*
